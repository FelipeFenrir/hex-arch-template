# Shared
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Security Server
SECURITY_MONGODB_URI=mongodb://localhost:27017/security
SECURITY_SERVER_PORT=9001
SECURITY_SERVER_LOG_FILE=build/logs/security-server.log

# OrderQuestionnaire - core
ORDERQUESTIONNAIRE_SERVER_PORT=9005
ORDERQUESTIONNAIRE_MONGODB_URI=mongodb://localhost:27017/orderquestionnaire
ORDERQUESTIONNAIRE_LOG_FILE=build/logs/orderquestionnaire.log

# OrderQuestionnaire - observability
ORDERQUESTIONNAIRE_OBS_LOG_ENABLED=true
ORDERQUESTIONNAIRE_OBS_LOG_ARGUMENTS=true
ORDERQUESTIONNAIRE_OBS_LOG_RESULT=true
ORDERQUESTIONNAIRE_OBS_MAX_PAYLOAD_LENGTH=4000

# OrderQuestionnaire - CORS (api-rest)
ORDERQUESTIONNAIRE_CORS_QUESTION_SEARCH_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTION_CREATE_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTION_UPDATE_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTION_DELETE_BY_ID_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTION_DELETE_BATCH_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTION_GET_BY_ID_ALLOWED_ORIGIN_PATTERN=http://localhost:*

ORDERQUESTIONNAIRE_CORS_QUESTIONNAIRE_SEARCH_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTIONNAIRE_CREATE_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTIONNAIRE_UPDATE_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTIONNAIRE_DELETE_BY_ID_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTIONNAIRE_DELETE_BATCH_ALLOWED_ORIGIN_PATTERN=http://localhost:*
ORDERQUESTIONNAIRE_CORS_QUESTIONNAIRE_GET_BY_ID_ALLOWED_ORIGIN_PATTERN=http://localhost:*

# OrderQuestionnaire - channel distribution
ORDERQUESTIONNAIRE_CHANNEL_DISTRIBUTION_PROVIDER=MONGO
ORDERQUESTIONNAIRE_CHANNEL_DISTRIBUTION_USE_APP_DATABASE=true
ORDERQUESTIONNAIRE_CHANNEL_DISTRIBUTION_API_BASE_URL=http://localhost:8082
ORDERQUESTIONNAIRE_CHANNEL_DISTRIBUTION_API_CONNECT_TIMEOUT=2s
ORDERQUESTIONNAIRE_CHANNEL_DISTRIBUTION_API_READ_TIMEOUT=3s
ORDERQUESTIONNAIRE_CHANNEL_DISTRIBUTION_API_AUTHENTICATION=false

# OrderQuestionnaire - journey distribution
ORDERQUESTIONNAIRE_JOURNEY_DISTRIBUTION_PROVIDER=MONGO
ORDERQUESTIONNAIRE_JOURNEY_DISTRIBUTION_USE_APP_DATABASE=true
ORDERQUESTIONNAIRE_JOURNEY_DISTRIBUTION_API_BASE_URL=http://localhost:8082
ORDERQUESTIONNAIRE_JOURNEY_DISTRIBUTION_API_CONNECT_TIMEOUT=2s
ORDERQUESTIONNAIRE_JOURNEY_DISTRIBUTION_API_READ_TIMEOUT=3s
ORDERQUESTIONNAIRE_JOURNEY_DISTRIBUTION_API_AUTHENTICATION=false
