{
  "id": null,
  "uid": "trace-investigation",
  "title": "Trace Investigation",
  "tags": ["local", "traces", "investigation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=~\".+\"}, app)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": ".+,TRACE,DEBUG,INFO,WARN,ERROR",
        "includeAll": false,
        "multi": false,
        "current": { "selected": true, "text": ".+", "value": ".+" }
      },
      {
        "name": "correlationId",
        "label": "Correlation ID (regex/text)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      },
      {
        "name": "traceId",
        "label": "Trace ID (regex/text)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      },
      {
        "name": "spanId",
        "label": "Span ID (regex/text)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Success (INFO/DEBUG/TRACE)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=~\"$app\",level=~\"INFO|DEBUG|TRACE\"} |~ \"$correlationId\" |~ \"$traceId\" |~ \"$spanId\" [5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (WARN)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=~\"$app\",level=\"WARN\"} |~ \"$correlationId\" |~ \"$traceId\" |~ \"$spanId\" [5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (ERROR)",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=~\"$app\",level=\"ERROR\"} |~ \"$correlationId\" |~ \"$traceId\" |~ \"$spanId\" [5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Investigation Logs",
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=~\"$app\",level=~\"$level\"} |~ \"$correlationId\" |~ \"$traceId\" |~ \"$spanId\" | json | line_format \"{{ .timestamp }}|{{ .service }}|{{ .app }}|{{ .level }}|trace={{ .traceId }}|span={{ .spanId }}|corr={{ .correlationId }}|flow={{ .flowId }}|{{ if .message }}{{ .message }}{{ else if .formattedMessage }}{{ .formattedMessage }}{{ else }}{{ __line__ }}{{ end }}\""
        }
      ],
      "options": {
        "showLabels": true,
        "showCommonLabels": true,
        "showTime": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Warning/Error Timeline",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=~\"$app\",level=~\"WARN|ERROR\"} |~ \"$correlationId\" |~ \"$traceId\" |~ \"$spanId\" | json | line_format \"{{ .timestamp }}|{{ .service }}|{{ .app }}|{{ .level }}|trace={{ .traceId }}|span={{ .spanId }}|{{ if .message }}{{ .message }}{{ else if .formattedMessage }}{{ .formattedMessage }}{{ else }}{{ __line__ }}{{ end }}\""
        }
      ],
      "options": {
        "showLabels": true,
        "showCommonLabels": true,
        "showTime": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}

