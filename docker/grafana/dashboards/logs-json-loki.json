{
  "id": null,
  "uid": "logs-json-loki",
  "title": "Logs JSON Loki",
  "tags": ["local", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
  "time": {
	"from": "now-1h",
	"to": "now"
  },
  "templating": {
	"list": [
	  {
		"name": "app",
		"label": "App",
		"type": "query",
		"datasource": { "type": "loki", "uid": "loki" },
		"query": "label_values({job=~\".+\"}, app)",
		"includeAll": true,
		"multi": true,
		"allValue": ".+",
		"current": { "selected": true, "text": "All", "value": "$__all" }
	  },
	  {
		"name": "mode",
		"label": "Mode",
		"type": "query",
		"datasource": { "type": "loki", "uid": "loki" },
		"query": "label_values({app=~\"$app\"}, mode)",
		"includeAll": true,
		"multi": true,
		"allValue": ".+",
		"current": { "selected": true, "text": "All", "value": "$__all" }
	  },
	  {
		"name": "level",
		"label": "Level",
		"type": "custom",
		"query": ".+,TRACE,DEBUG,INFO,WARN,ERROR",
		"includeAll": false,
		"multi": false,
		"current": { "selected": true, "text": ".+", "value": ".+" }
	  },
	  {
		"name": "correlationId",
		"label": "Correlation ID (regex/text)",
		"type": "textbox",
		"query": ".*",
		"current": { "selected": false, "text": ".*", "value": ".*" }
	  },
	  {
		"name": "flowId",
		"label": "Flow ID (regex/text)",
		"type": "textbox",
		"query": ".*",
		"current": { "selected": false, "text": ".*", "value": ".*" }
	  },
	  {
		"name": "traceId",
		"label": "Trace ID (regex/text)",
		"type": "textbox",
		"query": ".*",
		"current": { "selected": false, "text": ".*", "value": ".*" }
	  },
	  {
		"name": "spanId",
		"label": "Span ID (regex/text)",
		"type": "textbox",
		"query": ".*",
		"current": { "selected": false, "text": ".*", "value": ".*" }
	  }
	]
  },
  "panels": [
	{
	  "id": 1,
	  "type": "logs",
	  "title": "Application Logs (Host + Container)",
	  "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
	  "datasource": { "type": "loki", "uid": "loki" },
	  "targets": [
		{
		  "refId": "A",
		  "expr": "{app=~\"$app\",mode=~\"$mode\",level=~\"$level\"} |~ \"$correlationId\" |~ \"$flowId\" |~ \"$traceId\" |~ \"$spanId\" | json | line_format \"{{ if .message }}{{ .message }}{{ else if .formattedMessage }}{{ .formattedMessage }}{{ else }}{{ __line__ }}{{ end }}\""
		}
	  ],
	  "options": {
		"showLabels": true,
		"showCommonLabels": true,
		"showTime": true,
        "prettifyLogMessage": true,
		"sortOrder": "Descending"
	  }
	}
  ]
}

