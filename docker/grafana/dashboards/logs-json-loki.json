{
  "id": null,
  "uid": "logs-json-loki",
  "title": "Logs JSON Loki",
  "tags": ["local", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
	"from": "now-1h",
	"to": "now"
  },
  "templating": {
	"list": [
	  {
		"name": "app",
		"label": "App",
		"type": "query",
		"datasource": { "type": "loki", "uid": "loki" },
		"query": "label_values({job=~\".+\"}, app)",
		"includeAll": true,
		"multi": true,
		"allValue": ".+",
		"current": { "selected": true, "text": "All", "value": "$__all" }
	  },
	  {
		"name": "mode",
		"label": "Mode",
		"type": "query",
		"datasource": { "type": "loki", "uid": "loki" },
		"query": "label_values({app=~\"$app\"}, mode)",
		"includeAll": true,
		"multi": true,
		"allValue": ".+",
		"current": { "selected": true, "text": "All", "value": "$__all" }
	  },
	  {
		"name": "level",
		"label": "Level",
		"type": "custom",
		"query": ".+,TRACE,DEBUG,INFO,WARN,ERROR",
		"includeAll": false,
		"multi": false,
		"current": { "selected": true, "text": ".+", "value": ".+" }
	  }
	]
  },
  "panels": [
	{
	  "id": 1,
	  "type": "logs",
	  "title": "Application Logs (Host + Container)",
	  "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
	  "datasource": { "type": "loki", "uid": "loki" },
	  "targets": [
		{
		  "refId": "A",
		  "expr": "{app=~\"$app\",mode=~\"$mode\"} | json | line_format \"{{.message}}\" | level=~\"$level\""
		}
	  ],
	  "options": {
		"showLabels": true,
		"showCommonLabels": true,
		"showTime": true,
        "prettifyLogMessage": true,
		"sortOrder": "Descending"
	  }
	}
  ]
}

