{
  "id": null,
  "uid": "trace-topology",
  "title": "Trace Topology",
  "tags": ["local", "traces", "topology"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=~\".+\"}, app)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": ".+,TRACE,DEBUG,INFO,WARN,ERROR",
        "includeAll": false,
        "multi": false,
        "current": { "selected": true, "text": ".+", "value": ".+" }
      },
      {
        "name": "correlationId",
        "label": "Correlation ID (regex/text)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      },
      {
        "name": "traceId",
        "label": "Trace ID (regex/text)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      },
      {
        "name": "spanId",
        "label": "Span ID (regex/text)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 11,
      "type": "nodeGraph",
      "title": "Live Service Graph (Tempo)",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "options": {
        "nodes": {
          "mainStatUnit": "short",
          "secondaryStatUnit": "short"
        }
      }
    },
    {
      "id": 10,
      "type": "canvas",
      "title": "Reference Architecture Map",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 11 },
      "options": {
        "inlineEditing": true,
        "showAdvancedTypes": true,
        "panZoom": true,
        "infinitePan": false,
        "root": {
          "name": "Architecture Map",
          "type": "frame",
          "elements": [
            {
              "name": "OrderQuestionnaire",
              "type": "rectangle",
              "placement": { "top": 40, "left": 40, "width": 240, "height": 80 },
              "constraint": { "horizontal": "left", "vertical": "top" },
              "config": {
                "text": { "fixed": "orderquestionnaire" },
                "align": "center",
                "valign": "middle",
                "size": 20,
                "color": { "fixed": "#FFFFFF" }
              },
              "background": { "color": { "fixed": "#1F78C1" } },
              "border": { "color": { "fixed": "#0B3D91" }, "width": 2, "radius": 10 },
              "connections": [
